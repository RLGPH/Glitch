
@using Microsoft.AspNetCore.Components.Authorization

<nav class="main-nav" aria-label="Hovedmenu">

    <!-- LOGO -->
    <AuthorizeView>
        <Authorized>
            <a class="brand" href="/discover">
                <span class="brand-name">GLITCH</span>
                <span class="brand-slogan">
                    Dating uden barrierer
                </span>
            </a>
        </Authorized>

        <NotAuthorized>
            <a class="brand" href="/login">
                <span class="brand-name">GLITCH</span>
                <span class="brand-slogan">
                    Dating uden barrierer
                </span>
            </a>
        </NotAuthorized>
    </AuthorizeView>

    <!-- NAVIGATION -->
    <div class="nav-links">

        <AuthorizeView>

            <Authorized Context="auth">

                <!-- STARTSIDE EFTER LOGIN -->
                <NavLink href="/discover">
                    Opdag
                </NavLink>

                <!-- MATCHES -->
                <NavLink href="/matches">
                    Matches
                </NavLink>

                <!-- KONTO -->
                <NavLink href="/account">
                    Konto
                </NavLink>

                <!-- LOG UD -->
                <form method="post"
                      action="/auth/logout"
                      class="logout-form">

                    <AntiforgeryToken />

                    <button type="submit"
                            class="logout-button">
                        Log ud
                    </button>

                </form>

            </Authorized>

            <NotAuthorized>

                <!-- LOGIN -->
                <NavLink href="/login"
                         class="login-link">
                    Log ind
                </NavLink>

                <!-- REGISTRERING -->
                <NavLink href="/register">
                    Opret konto
                </NavLink>

            </NotAuthorized>

        </AuthorizeView>

    </div>

</nav>
