
@page "/my-profile"
@rendermode InteractiveServer


@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@using Glitch.Classes
@using Glitch.Data
@using Glitch.ViewModels
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms

@inject IDbContextFactory<GlitchDbContext> DbFactory

<PageTitle>Min profil – GLITCH</PageTitle>

<section class="profile-page">

    <header class="profile-header">
        <h1>Min profil</h1>
        <p>Fortæl lidt om dig selv, og hvad der gør dig unik.</p>
    </header>

    <div class="profile-card">

        @if (isLoading)
        {
            <p role="status">
                Henter interesser og diagnoser...
            </p>
        }
        else if (!string.IsNullOrEmpty(loadError))
        {
            <p role="alert" class="validation-message">
                @loadError
            </p>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="LoadOptionsAsync">
                Prøv igen
            </button>
        }
        else
        {
            <EditForm EditContext="editContext"
                      OnValidSubmit="HandleValidSubmit"
                      OnInvalidSubmit="ClearStatus"
                      FormName="my-profile">

                <DataAnnotationsValidator />

                <!-- PROFILBILLEDE -->
                <div class="profile-field">
                    <label for="profile-image">
                        Profilbillede
                    </label>

                    <InputFile id="profile-image"
                               OnChange="HandleImageSelected"
                               accept="image/jpeg,image/png" />

                    @if (!string.IsNullOrEmpty(imageError))
                    {
                        <p role="alert" class="validation-message">
                            @imageError
                        </p>
                    }

                    @if (!string.IsNullOrEmpty(imagePreviewUrl))
                    {
                        <img class="preview-image"
                             src="@imagePreviewUrl"
                             alt="Forhåndsvisning af profilbillede" />
                    }

                    @if (!string.IsNullOrEmpty(selectedImageName))
                    {
                        <p class="image-name">@selectedImageName</p>
                    }

                    <ValidationMessage
                        For="@(() => form.ProfileImage)" />

                    <small>JPEG eller PNG, maks. 2 MB.</small>
                </div>

                <!-- PROFILNAVN -->
                <div class="profile-field">
                    <label for="display-name">Dit navn</label>

                    <InputText id="display-name"
                               @bind-Value="form.DisplayName"
                               @bind-Value:after="ClearStatus" />

                    <ValidationMessage
                        For="@(() => form.DisplayName)" />
                </div>

                <!-- PROFILTEKST -->
                <div class="profile-field">
                    <label for="bio">Om dig</label>

                    <InputTextArea id="bio"
                                   rows="5"
                                   @bind-Value="form.Bio"
                                   @bind-Value:after="ClearStatus" />

                    <ValidationMessage
                        For="@(() => form.Bio)" />
                </div>

                <!-- INTERESSER FRA DATABASEN -->
                <fieldset class="profile-field">

                    <legend>Mine interesser</legend>

                    <p class="field-description">
                        Vælg de interesser, der passer til dig.
                    </p>

                    <div class="profile-options">
                        @foreach (var interest in interests)
                        {
                            <label class="profile-option"
                                   @key="interest.InterestID">

                                <input type="checkbox"
                                       checked="@form.SelectedInterests.Contains(interest.Name)"
                                       @onchange="e => ToggleInterest(interest.Name, e.Value is true)" />

                                <span>@interest.Name</span>
                            </label>
                        }
                    </div>

                </fieldset>

                <!-- DIAGNOSER FRA DATABASEN -->
                <fieldset class="profile-field">

                    <legend>Diagnoser og handicap</legend>

                    <p class="field-description">
                        Frivilligt – du behøver ikke vælge noget.
                    </p>

                    <div class="profile-options">
                        @foreach (var condition in conditions)
                        {
                            <label class="profile-option"
                                   @key="condition.ID">

                                <input type="checkbox"
                                       checked="@form.SelectedConditions.Contains(condition.Name)"
                                       @onchange="e => ToggleCondition(condition.Name, e.Value is true)" />

                                <span>@condition.Name</span>
                            </label>
                        }
                    </div>

                </fieldset>

                <!-- BRUGERDEFINERET DIAGNOSE -->
                <div class="profile-field">

                    <label for="custom-condition">
                        Andet (frivilligt)
                    </label>

                    <InputText id="custom-condition"
                               @bind-Value="form.CustomCondition"
                               @bind-Value:after="ClearStatus"
                               placeholder="Skriv en anden diagnose eller et handicap" />

                    <small>
                        Brugerdefinerede værdier hører til
                        kategorien Andet.
                    </small>
                </div>

                <!-- VALIDERING -->
                <button type="submit" class="btn btn-primary">
                    Kontrollér oplysninger
                </button>

            </EditForm>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <p role="status" class="profile-status">
                    @statusMessage
                </p>
            }
        }

    </div>
</section>

@code {

    // =====================================
    // FORMULAR OG STATUS
    // =====================================

    private readonly ProfileFormModel form = new();

    private EditContext editContext = default!;

    private string statusMessage = string.Empty;

    // Billedhåndtering
    private string imagePreviewUrl = string.Empty;
    private string imageError = string.Empty;
    private string selectedImageName = string.Empty;

    // =====================================
    // DATABASENS EKSISTERENDE MODELLER
    // =====================================

    private List<Interest> interests = new();
    private List<Condition> conditions = new();

    private bool isLoading = true;
    private string loadError = string.Empty;

    // =====================================
    // INITIALISERING
    // =====================================

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(form);

        await LoadOptionsAsync();
    }

    // =====================================
    // HENT VALGMULIGHEDER FRA SQLITE
    // =====================================

    private async Task LoadOptionsAsync()
    {
        isLoading = true;
        loadError = string.Empty;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            interests = await db.Interests
                .AsNoTracking()
                .OrderBy(i => i.Name)
                .ToListAsync();

            conditions = await db.Conditions
                .AsNoTracking()
                .Where(c => !c.IsCustom)
                .OrderBy(c => c.Name)
                .ToListAsync();
        }
        
catch (Exception ex)
{
    interests.Clear();
    conditions.Clear();

    // Udskriv den faktiske fejl i serverterminalen.
    Console.WriteLine("DATABASEFEJL I MYPROFILE:");
    Console.WriteLine(ex.ToString());

    // Vis en generel fejlbesked til brugeren.
    loadError =
        "Interesser og diagnoser kunne ikke indlæses. " +
        "Se serverterminalen for detaljer.";
}

        finally
        {
            isLoading = false;
        }
    }

    // =====================================
    // VÆLG INTERESSER
    // =====================================

    private void ToggleInterest(string interestName, bool selected)
    {
        if (selected)
        {
            if (!form.SelectedInterests.Contains(interestName))
                form.SelectedInterests.Add(interestName);
        }
        else
        {
            form.SelectedInterests.Remove(interestName);
        }

        ClearStatus();
    }

    // =====================================
    // VÆLG DIAGNOSER
    // =====================================

    private void ToggleCondition(string conditionName, bool selected)
    {
        if (selected)
        {
            if (!form.SelectedConditions.Contains(conditionName))
                form.SelectedConditions.Add(conditionName);
        }
        else
        {
            form.SelectedConditions.Remove(conditionName);
        }

        ClearStatus();
    }

    // =====================================
    // VALIDER FORMULAREN
    // =====================================

    private void HandleValidSubmit()
    {
        if (!string.IsNullOrEmpty(imageError))
        {
            statusMessage = "Ret fejlen ved profilbilledet.";
            return;
        }

        // TODO:
        // Backend mangler stadig en rigtig login-session,
        // så vi kan finde den indloggede brugers ProfileID.
        //
        // Når den er tilgængelig, kan vi bruge de eksisterende
        // UpdateProfileBasicsAsync og UpdateProfileAttributesAsync.
        //
        // De valgte interessenavne og diagnosenavne skal
        // mappes til deres eksisterende database-ID'er.

        statusMessage =
            "Oplysningerne er gyldige, " +
            "men endnu ikke gemt i databasen.";
    }

    private void ClearStatus()
    {
        statusMessage = string.Empty;
    }

    // =====================================
    // BILLEDUPLOAD OG FORHÅNDSVISNING
    // =====================================

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        ClearStatus();

        imagePreviewUrl = string.Empty;
        imageError = string.Empty;
        selectedImageName = string.Empty;

        form.ProfileImage = null;

        editContext.NotifyFieldChanged(
            new FieldIdentifier(form, nameof(form.ProfileImage)));

        var file = e.File;

        const long maxFileSize = 2 * 1024 * 1024;

        if (file.ContentType != "image/jpeg" &&
            file.ContentType != "image/png")
        {
            imageError = "Vælg et JPEG- eller PNG-billede.";
            return;
        }

        if (file.Size > maxFileSize)
        {
            imageError = "Billedet må højst fylde 2 MB.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxFileSize);
            using var memory = new MemoryStream();

            await stream.CopyToAsync(memory);

            var base64 = Convert.ToBase64String(
                memory.ToArray());

            imagePreviewUrl =
                $"data:{file.ContentType};base64,{base64}";

            selectedImageName = file.Name;
            form.ProfileImage = file;

            editContext.NotifyFieldChanged(
                new FieldIdentifier(
                    form,
                    nameof(form.ProfileImage)));
        }
        catch (IOException)
        {
            imageError =
                "Billedet kunne ikke læses. Prøv igen.";
        }
    }
}
