@page "/my-profile"
@rendermode InteractiveServer
@using Glitch.Models

<PageTitle>Min profil – GLITCH</PageTitle>

<section class="profile-page">
    <header class="profile-header">
        <h1>Min profil</h1>
        <p>Fortæl lidt om dig selv.</p>
    </header>

    <div class="profile-card">
        <div class="profile-field">
            <label for="display-name">Dit navn</label>
            <input id="display-name"
                   @bind="profile.DisplayName" />
        </div>

        <div class="profile-field">
            <label for="bio">Om dig</label>
            <textarea id="bio"
                      rows="4"
                      @bind="profile.Bio"></textarea>
        </div>
    </div>
</section>

@code {
    private Profile profile = new()
    {
        DisplayName = "Testbruger",
        Bio = "Jeg kan godt lide gaming og musik"
    };
}